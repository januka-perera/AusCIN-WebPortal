# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp

# Environment and secrets (use .env.example for required names instead)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies and build output (defense in depth for any app under apps/*
# that doesn't yet have its own .gitignore)
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
*.tsbuildinfo

# Python (apps/api, apps/worker, once introduced)
**/__pycache__/
*.pyc
**/.venv/
**/venv/

# Local sample data: keep metadata/config, never commit raw or generated media
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.tif
data/**/*.tiff
data/**/*.mp4
data/**/*.mov
data/**/*.mkv
data/**/*.db
data/**/*.sqlite

# Temporary processing files
*.tmp
.cache/
