# Configuration for the single-site CoastSnap importer (apps/worker).
# Names only, per AGENTS.md — never commit real values in this file.
# Export these in your shell/session, or keep a local, git-ignored
# .env file and load it however your shell/session manager prefers.

# --- Spotteron API (public GET by default; bearer token optional) ---

# Base URL for the Spotteron API, e.g. https://www.spotteron.com
# (see tools/check_spotteron_public_download.py for a known-working
# public request pattern against this domain).
SPOTTERON_BASE_URL=

# API version path segment. Confirmed by the project owner as "v2.4".
SPOTTERON_API_VERSION=v2.4

# Spotteron topic_id to filter spots by. Defaults to 37 if unset.
SPOTTERON_TOPIC_ID=

# Optional bearer token. Leave unset for unauthenticated public GET.
# Never logged, never embedded in image metadata, never committed.
SPOTTERON_BEARER_TOKEN=

# Page size for limit/page pagination. Optional; a sensible default is used if unset.
SPOTTERON_PAGE_LIMIT=

# Base URL used to build the Level 0 image download candidate from the
# opaque "attributes.image" reference returned by the Spotteron API
# (e.g. reference "000037/2026/09/23/xyz" becomes
# "<this>/000037/2026/09/23/xyz.jpg"). Defaults to
# https://files.spotteron.com/images/spots if unset.
SPOTTERON_IMAGE_BASE_URL=

# IANA timezone name used to interpret the real Spotteron
# "attributes.spotted_at" value, which is confirmed to have NO
# timezone marker at all (e.g. "2026-09-23 14:57:28"). Defaults to
# "UTC" if unset — this is an explicit, documented ASSUMPTION, not a
# confirmed fact (Spotteron's real server-side timezone convention has
# not been confirmed). Override once the real convention is known,
# e.g. "Australia/Brisbane". Only affects timezone-less spotted_at
# values; a value with an explicit "Z"/offset is always trusted as-is.
# See spotteron_client.py's "Timestamp interpretation policy".
SPOTTERON_SOURCE_TIMEZONE=

# --- Local processing ---

# Local staging directory for Level 0/Level 1 files, source-record
# JSON and the manifest. Must never be committed to git.
COASTSNAP_STAGING_DIR=

# Which XMP-capable metadata backend to use: "exiftool" (default) or
# "argus" (not implemented in this version — see metadata_embedder.py).
COASTSNAP_METADATA_BACKEND=

# Path to the exiftool binary, if not already on PATH.
EXIFTOOL_PATH=

# --- Gadi SFTP transfer ---

GADI_SFTP_HOST=
GADI_SFTP_PORT=
GADI_SFTP_USERNAME=

# Path to a private key file for unattended SSH-key authentication.
# Password-based authentication is not supported by this importer.
GADI_SFTP_PRIVATE_KEY_PATH=

# How the SFTP publisher verifies a remote checksum: "ssh-exec" (default,
# runs sha256sum over an exec_command channel) or "read-back" (streams the
# remote file back over SFTP and hashes it locally — use this if the
# remote host has no sha256sum on PATH or exec_command is disallowed).
GADI_CHECKSUM_STRATEGY=

# Remote root directory for this proof of concept.
# Defaults to /g/data/qu34/AusCIN/coastsnap-test if unset — NOTE: this
# default is itself under /g/data/qu34 (the production NCI project
# storage), so --transfer refuses to run against it (or any other
# GADI_REMOTE_ROOT starting with /g/data/qu34) unless the CLI flag
# --confirm-production-remote-root is also passed. This is deliberate:
# --transfer should never touch production storage by accident.
GADI_REMOTE_ROOT=
