# Configuration for the single-site CoastSnap importer (apps/worker).
# Names only, per AGENTS.md — never commit real values in this file.
# Export these in your shell/session, or keep a local, git-ignored
# .env file and load it however your shell/session manager prefers.

# --- Spotteron API (public GET by default; bearer token optional) ---

# Base URL for the Spotteron API, e.g. https://www.spotteron.com
# (see tools/check_spotteron_public_download.py for a known-working
# public request pattern against this domain).
SPOTTERON_BASE_URL=

# API version path segment. Confirmed by the project owner as "v2.4".
SPOTTERON_API_VERSION=v2.4

# Spotteron topic_id to filter spots by. Defaults to 37 if unset.
SPOTTERON_TOPIC_ID=

# Optional bearer token. Leave unset for unauthenticated public GET.
# Never logged, never embedded in image metadata, never committed.
SPOTTERON_BEARER_TOKEN=

# Page size for limit/page pagination. Optional; a sensible default is used if unset.
SPOTTERON_PAGE_LIMIT=

# --- Local processing ---

# Local staging directory for Level 0/Level 1 files, source-record
# JSON and the manifest. Must never be committed to git.
COASTSNAP_STAGING_DIR=

# Which XMP-capable metadata backend to use: "exiftool" (default) or
# "argus" (not implemented in this version — see metadata_embedder.py).
COASTSNAP_METADATA_BACKEND=

# Path to the exiftool binary, if not already on PATH.
EXIFTOOL_PATH=

# --- Gadi SFTP transfer ---

GADI_SFTP_HOST=
GADI_SFTP_PORT=
GADI_SFTP_USERNAME=

# Path to a private key file for unattended SSH-key authentication.
# Password-based authentication is not supported by this importer.
GADI_SFTP_PRIVATE_KEY_PATH=

# Remote root directory for this proof of concept.
# Defaults to /g/data/qu34/AusCIN/coastsnap-test if unset.
GADI_REMOTE_ROOT=
