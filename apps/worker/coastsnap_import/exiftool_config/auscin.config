#------------------------------------------------------------------------------
# ExifTool user-defined tag config for AusCIN CoastSnap provenance fields.
#
# Registers a custom XMP namespace ("auscin") so exiftool will accept
# -XMP-auscin:* tags. Standard Dublin Core / XMP-photoshop fields
# already cover source/date/creator; the fields below are the ones
# with no natural home in an existing schema (Spotteron's own IDs).
#
# The namespace URI below is a project convention chosen for this
# proof of concept, not an externally registered/confirmed standard —
# flagged as such in the implementation report. Update it if the
# project settles on a different URI before this leaves the PoC stage.
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        auscin => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::auscin',
            },
        },
    },
);

%Image::ExifTool::UserDefined::auscin = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-auscin', 2 => 'Image' },
    NAMESPACE => { 'auscin' => 'https://auscin.example/xmp/1.0/' },
    WRITABLE => 'string',
    SourcePlatform         => { },
    SpotteronRootId        => { },
    SpotteronObservationId => { },
    SpotteronMediaReference => { },
);

1;  #end
