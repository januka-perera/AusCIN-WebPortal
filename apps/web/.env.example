# Configuration for the /map network page's interactive basemap
# (see app/map/tile-config.ts). Do not put real values in this file —
# copy it to .env.local and fill it in there for your own machine.

# Raster tile URL template for the map, e.g.
# https://tiles.example.com/{z}/{x}/{y}.png from a licensed provider
# (MapTiler, Stadia Maps, Mapbox raster tiles, etc). If left unset, the
# app falls back to OpenStreetMap's public tile server, which is fine
# for local development but is NOT approved for production traffic —
# set a real provider before deploying. Set to the literal value
# "disabled" to preview the map's "no basemap configured" fallback.
NEXT_PUBLIC_MAP_TILE_URL=

# Optional attribution HTML shown under the map for the tile provider
# above. Defaults to the OpenStreetMap attribution when unset.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- CoastSnap catalogue API (server-side only; never NEXT_PUBLIC_) ---------
#
# Base URL of the AusCIN catalogue API (apps/api), e.g. http://localhost:8000
# for local development. Unset or blank: the /coastsnap pages use the
# built-in synthetic sample repository and no API is needed (this is the
# default, and what every unit test uses). Set: /coastsnap reads sites,
# observations, date ranges and media detail from the API. Read at request
# time on the server; it is never sent to the browser. Must be http(s) with
# no credentials, query or fragment.
COASTSNAP_API_BASE_URL=

# Optional browser-reachable origin that CoastSnap media URLs (thumbnails,
# previews, original downloads) must use, e.g. http://localhost:8000.
# Defaults to the origin of COASTSNAP_API_BASE_URL. Root-relative media URLs
# from the API are resolved against this origin — never against the Next.js
# origin — and absolute media URLs on any other origin are dropped. Set this
# when the server reaches the API on an internal address that browsers
# can't use. For local development, also start the API with
# AUSCIN_MEDIA_BASE_URL set to the same origin (see apps/api/README.md).
COASTSNAP_MEDIA_ORIGIN=
