# Configuration for ONE real CoastSnap test site (staging workflow).
#
# TEMPLATE ONLY. Every value is a placeholder and must stay that way in git.
# Copy this file OUTSIDE the repository, fill it in there, and validate it:
#
#   cp apps/api/config/coastsnap-site.env.example "$HOME/auscin-site/coastsnap-site.env"
#   python -m auscin_api.site_config validate --env-file "$HOME/auscin-site/coastsnap-site.env"
#
# The validator is offline: it never contacts Spotteron, Gadi or NCI. It
# refuses unfilled <...> placeholders, invalid values, local paths inside
# the repository, and local paths under /g/data.
# See docs/implementation/coastsnap-real-site-staging.md for the full runbook.
#
# No credentials belong in this file. Spotteron and Gadi SFTP settings stay
# in the worker's own environment (apps/worker/.env.example).

# --- Site identity ---------------------------------------------------------

# Spotteron root/site ID for the test site (a plain identifier).
SPOTTERON_ROOT_ID=<SPOTTERON_ROOT_ID>

# Public AusCIN site ID used in URLs: uppercase, starts with CS-,
# e.g. CS-EXAMPLE-BEACH.
COASTSNAP_SITE_SLUG=<COASTSNAP_SITE_SLUG>

# --- Reviewed site metadata (shown publicly) -----------------------------------

COASTSNAP_SITE_NAME=<COASTSNAP_SITE_NAME>
# One of NSW, VIC, QLD, WA, SA, TAS, NT, ACT.
COASTSNAP_SITE_STATE=<COASTSNAP_SITE_STATE>
# Region or local government area, e.g. "Central Coast, NSW".
COASTSNAP_SITE_REGION=<COASTSNAP_SITE_REGION>
# At least 20 characters: what the site is and what its alignment mark frames.
COASTSNAP_SITE_DESCRIPTION=<COASTSNAP_SITE_DESCRIPTION>
# Decimal degrees (southern latitudes are negative).
COASTSNAP_SITE_LATITUDE=<COASTSNAP_SITE_LATITUDE>
COASTSNAP_SITE_LONGITUDE=<COASTSNAP_SITE_LONGITUDE>
# IANA time zone used to display capture times, e.g. Australia/Sydney.
COASTSNAP_SITE_TIME_ZONE=<COASTSNAP_SITE_TIME_ZONE>
# ISO date (YYYY-MM-DD) the site opened for public contributions.
COASTSNAP_SITE_ESTABLISHED_SINCE=<COASTSNAP_SITE_ESTABLISHED_SINCE>
# Credit line shown with every photo. Must reflect the agreed licence and
# attribution policy.
COASTSNAP_SITE_ATTRIBUTION_TEXT=<COASTSNAP_SITE_ATTRIBUTION_TEXT>

# --- Explicit, reviewed publication decisions (no defaults) --------------------

# One of public, embargoed, project-only, restricted. Only "public" is
# served by the catalogue API. Keep it non-public until the staged data has
# been reviewed.
COASTSNAP_SITE_PUBLICATION_STATUS=<COASTSNAP_SITE_PUBLICATION_STATUS>
# Download permission per product level. Each must be exactly true or false.
# There is no default and neither implies the other. Start both at false, and
# enable a level only deliberately, once the licence decision allows it.
#   Level 0: the untouched source image, exactly as downloaded from Spotteron.
#   Level 1: the AusCIN provenance copy (Level 0 plus embedded provenance XMP).
# For the private staging preview, enable both only deliberately, e.g. to
# review both downloads.
COASTSNAP_SITE_LEVEL0_DOWNLOAD_PERMITTED=<COASTSNAP_SITE_LEVEL0_DOWNLOAD_PERMITTED>
COASTSNAP_SITE_LEVEL1_DOWNLOAD_PERMITTED=<COASTSNAP_SITE_LEVEL1_DOWNLOAD_PERMITTED>

# --- Local staging paths (absolute, OUTSIDE the repository, never /g/data) -----

# The worker's staging directory (Level 0/1, source records, manifests).
COASTSNAP_STAGING_DIR=<COASTSNAP_STAGING_DIR>
# Where the derivatives command writes thumbnails/previews. Must differ
# from the staging directory.
COASTSNAP_DERIVATIVES_ROOT=<COASTSNAP_DERIVATIVES_ROOT>
# Must be the worker's default: <COASTSNAP_STAGING_DIR>/manifests/<SPOTTERON_ROOT_ID>.json
COASTSNAP_MANIFEST_PATH=<COASTSNAP_MANIFEST_PATH>
# Derivatives index written by the derivatives command, e.g.
# <COASTSNAP_DERIVATIVES_ROOT>/derivatives-index.json
COASTSNAP_DERIVATIVES_INDEX_PATH=<COASTSNAP_DERIVATIVES_INDEX_PATH>

# --- Remote publication root (used only by the final, reviewed SFTP step) ------

# REMOTE absolute path on NCI that the worker's --transfer writes under (it
# becomes GADI_REMOTE_ROOT). It is never read or accessed locally. It is only
# required by `validate --for-transfer`. It must be a dedicated
# subdirectory, not the project root.
NCI_PUBLICATION_ROOT=<NCI_PUBLICATION_ROOT>
