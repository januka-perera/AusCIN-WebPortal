# Configuration for the AusCIN catalogue API (apps/api).
# Names only, per AGENTS.md — never commit real values in this file.
# Copy to a git-ignored .env (or export in your shell) and fill in locally.

# For one REAL CoastSnap test site, don't fill this file in directly. Start
# from apps/api/config/coastsnap-site.env.example, copied outside the
# repository, validate it with `python -m auscin_api.site_config validate`,
# and follow docs/implementation/coastsnap-real-site-staging.md. The site's
# registry is generated by `python -m auscin_api.site_config write-registry`.

# Runtime environment: "development" (default), "test" or "production".
# Only "production" may point catalogue or media inputs under /g/data; every
# other environment refuses such paths outright. Production serving is not
# implemented yet.
AUSCIN_API_ENV=development

# Reviewed CoastSnap site registry (JSON). Only sites marked
# "publication_status": "public" here are ever exposed by the API, and only
# sites with "original_download_permitted": true offer original downloads.
# For local development, point this at the committed synthetic fixture:
#   tests/fixtures/coastsnap/sites-registry.json
COASTSNAP_SITE_REGISTRY_PATH=

# Worker manifests (apps/worker's manifests/<root_id>.json format), one per
# CoastSnap site. These are explicit catalogue inputs: the API loads exactly
# the files listed and never searches a directory for others.
#
# One site: set COASTSNAP_MANIFEST_PATH. For local development, point it at
# the committed synthetic fixture:
#   tests/fixtures/coastsnap/manifest.json
# Several sites: set COASTSNAP_MANIFEST_PATHS instead, a list separated by
# the OS path separator (";" on Windows, ":" on POSIX). Setting both is
# refused. Every manifest must have a different root_id.
COASTSNAP_MANIFEST_PATH=
COASTSNAP_MANIFEST_PATHS=

# Optional thumbnail/preview indexes written by the worker's
# `python -m coastsnap_import.derivatives` command (schema_version 2), at
# most one per manifest. Each is paired with the manifest whose root_id it
# records, so list order doesn't matter; an index for a root that isn't
# configured is refused. A manifest without an index offers no thumbnail or
# preview URLs. Use the singular form with COASTSNAP_MANIFEST_PATH, or the
# list form (same separator) with several manifests. Setting both is refused.
#   tests/fixtures/coastsnap/derivatives-index.json
COASTSNAP_DERIVATIVES_INDEX_PATH=
COASTSNAP_DERIVATIVES_INDEX_PATHS=

# Optional directory the derivatives index's paths resolve beneath — the
# worker derivatives command's --output-root. Unset: COASTSNAP_MEDIA_ROOT
# is used. Requires COASTSNAP_MEDIA_ROOT.
COASTSNAP_DERIVATIVES_ROOT=

# Optional local media root (the worker's staging directory) that the
# manifest's Level 1 paths resolve beneath. Unset: no media URLs, and media endpoints
# return 503. For local development, generate synthetic media first:
#   .venv\Scripts\python.exe tests\fixtures\synthetic_media.py .local-media
# then set this to .local-media (git-ignored).
COASTSNAP_MEDIA_ROOT=

# Optional http(s) origin prefixed to media URLs in JSON responses, e.g.
# http://localhost:8000. Unset: root-relative URLs (/media/coastsnap/...).
AUSCIN_MEDIA_BASE_URL=
